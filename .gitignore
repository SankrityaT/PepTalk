# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright mcp artifacts
.playwright-mcp/
.render/

# Match footage. Not ours to redistribute — the tape is fetched locally and
# stays out of the repo. See README for how to supply your own clip.
/public/tape/
/public/clips/
# Stills cut from the broadcast for calibration. Frames of the footage are the
# footage, and the whole project keeps it out of the repository. Only the
# homography derived from them is committed.
/public/calib/

# ── Backend ─────────────────────────────────────────────────────────────
.cache/
results/
.venv/
__pycache__/
*.pyc
.env
hydradb-data/
*.pt
*.mkv
*.mp4
sn-data/
.playwright-mcp/
*.png

# Games added through the interface. Generated output and, where footage was
# uploaded, clips cut from a recording that is not ours to redistribute. The
# built-in workspace is committed; everything a coach adds is not.
workspaces/*/
!workspaces/wc2022/
workspaces/*/snapshots/
workspaces/*/clips/

# Generated by scripts/use-workspace.mjs from the selected workspace.
src/content/snapshots/active/
# Which workspace the interface last opened on. Local state, not a shared
# decision: two people working on two teams should not fight over it.
src/content/snapshots/.active

# Snapshots for games added through the interface. Regenerated by bootstrap
# from public data, and named after a match id nobody else is working on, so
# committing them is noise. The example set stays tracked.
src/content/snapshots/*/
!src/content/snapshots/wc2022/
